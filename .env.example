# Environment Variables for F1 Race Prediction System

# OpenWeatherMap API (required for weather forecasts)
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# FastF1 Cache Directory (optional, defaults to ./cache)
FASTF1_CACHE_DIR=./cache

# Model Storage (optional)
MODEL_SAVE_DIR=./models

# Logging Level (optional)
LOG_LEVEL=INFO

# Database (optional, for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/f1_predictions
